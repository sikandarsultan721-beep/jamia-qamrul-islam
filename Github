<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Jamia Qamrul Islam</title>

<style>
*{
    box-sizing:border-box;
    margin:0;
    padding:0;
}

body{
    font-family:Arial,Helvetica,sans-serif;
    background:#f3f5ef;
    color:#183d2b;
}

header{
    background:linear-gradient(135deg,#f8f5e8,#e9f0e5);
    padding:18px 5%;
    border-bottom:4px solid #c8a34b;
}

.header-inner{
    max-width:1200px;
    margin:auto;
    display:flex;
    align-items:center;
    gap:20px;
}

.logo{
    width:100px;
    height:100px;
    object-fit:contain;
    border-radius:50%;
}

.header-text h1{
    color:#14532d;
    font-family:Georgia,serif;
    font-size:38px;
}

.header-text p{
    color:#92742c;
    font-size:16px;
    margin-top:7px;
}

nav{
    background:#06452d;
    box-shadow:0 3px 10px #0002;
}

.nav-inner{
    max-width:1200px;
    margin:auto;
    display:flex;
    flex-wrap:wrap;
    align-items:center;
}

nav button{
    border:0;
    background:transparent;
    color:white;
    padding:15px 18px;
    cursor:pointer;
    font-size:15px;
}

nav button:hover,
nav button.active{
    background:#c9a33b;
    color:#083b27;
}

.container{
    max-width:1200px;
    margin:auto;
    padding:25px 15px;
}

.page{
    display:none;
}

.page.active{
    display:block;
}

.hero{
    background:linear-gradient(135deg,#edf4e9,#fffdf4);
    border:1px solid #d7d9c9;
    border-radius:20px;
    padding:35px;
    margin-bottom:25px;
    box-shadow:0 7px 25px #00000012;
}

.hero h2{
    font-family:Georgia,serif;
    color:#075c38;
    font-size:36px;
    margin-bottom:12px;
}

.hero h3{
    color:#b18b31;
    font-size:25px;
    margin-bottom:12px;
}

.hero p{
    color:#555;
    line-height:1.7;
    font-size:17px;
}

.features{
    display:grid;
    grid-template-columns:repeat(4,1fr);
    gap:15px;
    margin-top:25px;
}

.feature{
    background:white;
    border-radius:14px;
    padding:18px;
    text-align:center;
    border:1px solid #ddd;
    box-shadow:0 4px 12px #0000000d;
}

.feature .icon{
    font-size:30px;
    margin-bottom:8px;
}

.feature strong{
    color:#075c38;
}

.slider{
    width:100%;
    height:350px;
    overflow:hidden;
    border-radius:18px;
    margin-bottom:25px;
    background:#ddd;
    box-shadow:0 7px 25px #0002;
}

.slides{
    display:flex;
    width:400%;
    height:100%;
    animation:slide 16s infinite;
}

.slide{
    width:25%;
    flex-shrink:0;
}

.slide img{
    width:100%;
    height:100%;
    object-fit:cover;
}

@keyframes slide{
    0%,20%{transform:translateX(0);}
    25%,45%{transform:translateX(-25%);}
    50%,70%{transform:translateX(-50%);}
    75%,95%{transform:translateX(-75%);}
    100%{transform:translateX(0);}
}

.cards{
    display:grid;
    grid-template-columns:1.1fr 1fr .9fr;
    gap:20px;
}

.card{
    background:white;
    border-radius:16px;
    overflow:hidden;
    box-shadow:0 5px 20px #00000012;
    border:1px solid #ddd;
}

.card-header{
    background:#075c38;
    color:white;
    padding:17px 20px;
    font-size:20px;
    font-weight:bold;
}

.card-body{
    padding:20px;
}

input,select{
    width:100%;
    padding:13px;
    border:1px solid #ccc;
    border-radius:8px;
    margin:7px 0 12px;
    font-size:15px;
}

.btn{
    width:100%;
    padding:13px;
    border:0;
    border-radius:8px;
    background:#075c38;
    color:white;
    font-size:16px;
    cursor:pointer;
}

.btn:hover{
    background:#0a7548;
}

.btn.gold{
    background:#b18b31;
}

.notice{
    background:#f8f5e8;
    border-left:4px solid #c5a13d;
    padding:13px;
    margin-bottom:10px;
    border-radius:6px;
}

.quick{
    display:block;
    width:100%;
    text-align:left;
    padding:14px;
    margin-bottom:10px;
    border:1px solid #ddd;
    background:#f7faf5;
    border-radius:9px;
    color:#075c38;
    cursor:pointer;
    font-size:15px;
}

.quick:hover{
    background:#e9f2e7;
}

.result-wrapper{
    max-width:850px;
    margin:auto;
}

.result-card{
    background:white;
    border:7px solid #075c38;
    box-shadow:0 10px 35px #0003;
    padding:28px;
    position:relative;
}

.result-top{
    display:flex;
    justify-content:space-between;
    align-items:flex-start;
    border-bottom:3px solid #c5a13d;
    padding-bottom:18px;
    margin-bottom:20px;
}

.result-title{
    text-align:center;
    flex:1;
}

.result-title h2{
    color:#075c38;
    font-family:Georgia,serif;
    font-size:29px;
}

.result-title h3{
    color:#b18b31;
    margin-top:6px;
}

.student-photo{
    width:105px;
    height:125px;
    border:3px solid #b18b31;
    object-fit:cover;
    margin-left:15px;
    background:#eee;
}

.info-grid{
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:10px;
    margin-bottom:20px;
}

.info-box{
    border:1px solid #d9d9d9;
    padding:11px;
    border-radius:6px;
    background:#fafbf8;
}

.info-box strong{
    color:#075c38;
}

.marks-table{
    width:100%;
    border-collapse:collapse;
    margin:20px 0;
}

.marks-table th{
    background:#075c38;
    color:white;
}

.marks-table th,
.marks-table td{
    border:1px solid #ccc;
    padding:10px;
    text-align:center;
}

.marks-table tr:nth-child(even){
    background:#f5f7f1;
}

.summary{
    display:grid;
    grid-template-columns:repeat(4,1fr);
    gap:8px;
    margin-top:15px;
}

.summary-box{
    background:#eef4eb;
    border:1px solid #d0dacb;
    border-radius:7px;
    text-align:center;
    padding:12px 5px;
}

.summary-box strong{
    display:block;
    color:#075c38;
    font-size:17px;
    margin-top:5px;
}

.status{
    text-align:center;
    padding:13px;
    margin-top:15px;
    border:2px solid #075c38;
    color:#075c38;
    font-weight:bold;
    border-radius:8px;
}

.signatures{
    display:grid;
    grid-template-columns:repeat(3,1fr);
    gap:20px;
    margin-top:45px;
    text-align:center;
}

.signature{
    border-top:1px solid #555;
    padding-top:8px;
    font-size:13px;
}

.result-actions{
    display:flex;
    gap:10px;
    margin-top:20px;
}

.result-actions button{
    flex:1;
}

.admin-box{
    max-width:500px;
    margin:30px auto;
    background:white;
    padding:30px;
    border-radius:15px;
    box-shadow:0 5px 25px #0002;
}

.admin-box h2{
    text-align:center;
    color:#075c38;
    margin-bottom:20px;
}

.admin-panel{
    display:none;
}

.admin-panel.show{
    display:block;
}

.admin-actions{
    display:grid;
    grid-template-columns:repeat(3,1fr);
    gap:10px;
    margin-bottom:20px;
}

.gallery{
    display:grid;
    grid-template-columns:repeat(2,1fr);
    gap:18px;
}

.gallery img{
    width:100%;
    height:280px;
    object-fit:cover;
    border-radius:14px;
    box-shadow:0 5px 18px #0002;
}

footer{
    background:#063d29;
    color:white;
    margin-top:40px;
    padding:25px;
    text-align:center;
    border-top:4px solid #c5a13d;
}

footer h3{
    color:#e2bd55;
    font-family:Georgia,serif;
    margin-bottom:6px;
}

.message{
    padding:12px;
    border-radius:7px;
    margin-top:10px;
    display:none;
}

.success{
    background:#dff2df;
    color:#175b26;
}

.error{
    background:#f7dddd;
    color:#8b2020;
}

@media(max-width:800px){

    .header-inner{
        flex-direction:column;
        text-align:center;
    }

    .header-text h1{
        font-size:28px;
    }

    .features{
        grid-template-columns:repeat(2,1fr);
    }

    .cards{
        grid-template-columns:1fr;
    }

    .slider{
        height:230px;
    }

    .hero{
        padding:22px;
    }

    .hero h2{
        font-size:28px;
    }

    .result-card{
        padding:15px;
    }

    .summary{
        grid-template-columns:repeat(2,1fr);
    }

    .signatures{
        grid-template-columns:1fr;
        margin-top:30px;
