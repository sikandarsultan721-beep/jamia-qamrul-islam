<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Jamia Qamrul Islam</title>

<script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>

<style>
*{
    box-sizing:border-box;
    margin:0;
    padding:0;
}

body{
    font-family:Arial, sans-serif;
    background:#f4f7f3;
    color:#183d2b;
}

header{
    background:#064d36;
    color:#fff;
    padding:15px 20px;
    display:flex;
    align-items:center;
    gap:15px;
    box-shadow:0 3px 10px #0003;
}

.logo{
    width:65px;
    height:65px;
    object-fit:contain;
    border-radius:50%;
    background:white;
    padding:4px;
}

.header-text h1{
    font-size:25px;
}

.header-text p{
    color:#e5c45b;
    margin-top:5px;
}

nav{
    background:#032f22;
    display:flex;
    justify-content:center;
    flex-wrap:wrap;
}

nav button{
    background:none;
    border:0;
    color:white;
    padding:14px 17px;
    cursor:pointer;
    font-size:15px;
}

nav button:hover{
    background:#0a6246;
}

.container{
    max-width:1100px;
    margin:auto;
    padding:20px;
}

.hero{
    background:linear-gradient(135deg,#064d36,#0a7653);
    color:white;
    padding:35px 20px;
    border-radius:15px;
    text-align:center;
    margin-bottom:25px;
}

.hero h2{
    font-size:30px;
    color:#f1d36b;
    margin-bottom:10px;
}

.slider{
    width:100%;
    height:280px;
    overflow:hidden;
    border-radius:15px;
    margin-bottom:25px;
    box-shadow:0 4px 15px #0003;
    background:#ddd;
}

.slider img{
    width:100%;
    height:100%;
    object-fit:cover;
    display:none;
}

.slider img.active{
    display:block;
}

.card{
    background:white;
    padding:25px;
    border-radius:15px;
    margin-bottom:25px;
    box-shadow:0 3px 15px #0002;
    border-top:4px solid #c9a52b;
}

.card h2{
    color:#075438;
    margin-bottom:18px;
}

input,select{
    width:100%;
    padding:12px;
    margin:7px 0 12px;
    border:1px solid #ccc;
    border-radius:7px;
    font-size:15px;
}

.btn{
    background:#075438;
    color:white;
    border:0;
    padding:12px 20px;
    border-radius:7px;
    cursor:pointer;
    margin:5px 3px;
}

.btn:hover{
    background:#0a7653;
}

.gold{
    background:#c9a52b;
    color:#172d20;
}

.hidden{
    display:none;
}

.notice{
    padding:15px;
    background:#f8f1d5;
    border-left:5px solid #c9a52b;
    border-radius:7px;
    margin-bottom:10px;
}

.result-card{
    background:white;
    border:5px solid #075438;
    padding:25px;
    max-width:800px;
    margin:20px auto;
    box-shadow:0 5px 20px #0003;
}

.result-head{
    text-align:center;
    border-bottom:3px solid #c9a52b;
    padding-bottom:15px;
    margin-bottom:20px;
}

.result-head h1{
    color:#075438;
}

.student-info{
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:10px;
    margin-bottom:20px;
}

.info-box{
    border:1px solid #ccc;
    padding:10px;
    border-radius:6px;
}

.marks-table{
    width:100%;
    border-collapse:collapse;
    margin-top:15px;
}

.marks-table th,
.marks-table td{
    border:1px solid #aaa;
    padding:10px;
    text-align:center;
}

.marks-table th{
    background:#075438;
    color:white;
}

.summary{
    display:grid;
    grid-template-columns:repeat(4,1fr);
    gap:8px;
    margin-top:20px;
}

.summary div{
    background:#eef5ef;
    border:1px solid #c9a52b;
    padding:12px 5px;
    text-align:center;
    border-radius:7px;
}

.signatures{
    display:grid;
    grid-template-columns:1fr 1fr 1fr;
    gap:20px;
    margin-top:55px;
    text-align:center;
}

.signature-line{
    border-top:1px solid #333;
    padding-top:7px;
}

.gallery{
    display:grid;
    grid-template-columns:repeat(2,1fr);
    gap:15px;
}

.gallery img{
    width:100%;
    height:220px;
    object-fit:cover;
    border-radius:12px;
}

footer{
    background:#032f22;
    color:white;
    text-align:center;
    padding:25px 15px;
    margin-top:30px;
}

footer strong{
    color:#e5c45b;
}

@media(max-width:600px){
    .header-text h1{
        font-size:20px;
    }

    .logo{
        width:55px;
        height:55px;
    }

    .slider{
        height:200px;
    }

    .student-info,
    .signatures{
        grid-template-columns:1fr;
    }

    .summary{
        grid-template-columns:1fr 1fr;
    }

    .gallery{
        grid-template-columns:1fr;
    }

    .gallery img{
        height:200px;
    }

    nav button{
        padding:10px;
        font-size:13px;
    }
}

@media print{
    body{
        background:white;
    }

    nav,
    footer,
    .no-print{
        display:none !important;
    }

    .result-card{
        box-shadow:none;
        margin:0;
    }
}
</style>
</head>

